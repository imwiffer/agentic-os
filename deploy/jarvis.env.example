# /etc/jarvis/jarvis.env  (chmod 600, owned by root:jarvis)
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
JARVIS_DATA_DIR=/srv/jarvis/data
JARVIS_DB=/srv/jarvis/data/jarvis.db
JARVIS_WORKSPACE=/srv/jarvis/workspace

# Required: bootstrap.sh generates a random 64-hex token if left blank
JARVIS_AUTH_TOKEN=
# Optional: your Tailscale login (e.g. you@github) for automatic SSO via `tailscale serve`
JARVIS_TAILSCALE_USERS=

# Local CPU model via Ollama + cloud fallback via OpenRouter
OLLAMA_URL=http://127.0.0.1:11434
JARVIS_DEFAULT_MODEL=qwen2.5:7b-instruct
JARVIS_EMBED_MODEL=nomic-embed-text
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
JARVIS_FALLBACK_MODEL=qwen/qwen-2.5-72b-instruct

# Tool policy: readonly | confirm | auto
JARVIS_TOOL_MODE=confirm
JARVIS_SCHEDULER=true
JARVIS_TZ=UTC
