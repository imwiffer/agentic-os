# Copy to backend/.env and adjust.

# --- LLM -----------------------------------------------------------------
# Local models via Ollama:  ollama pull llama3:8b
OLLAMA_URL=http://localhost:11434
JARVIS_DEFAULT_MODEL=llama3:8b
# Cloud models via any OpenAI-compatible API (OpenRouter, OpenAI, Groq...)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=

# --- Voice ---------------------------------------------------------------
# browser | whisper | vosk
STT_ENGINE=browser
WHISPER_MODEL=small.en
VOSK_MODEL_PATH=
# browser | elevenlabs | coqui
TTS_ENGINE=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
