# Copy to backend/.env (local dev) or /etc/jarvis/jarvis.env (VPS) and adjust.

# --- Server & security ---------------------------------------------------
JARVIS_HOST=127.0.0.1
JARVIS_PORT=8000
# Generate with: openssl rand -hex 32   (required on the VPS; leave blank for local dev)
JARVIS_AUTH_TOKEN=
# Optional: Tailscale login(s) trusted via `tailscale serve` headers (comma-separated, e.g. you@github)
JARVIS_TAILSCALE_USERS=

# --- LLM -----------------------------------------------------------------
# Local models via Ollama (CPU-friendly default):  ollama pull qwen2.5:7b-instruct
OLLAMA_URL=http://127.0.0.1:11434
JARVIS_DEFAULT_MODEL=qwen2.5:7b-instruct
JARVIS_EMBED_MODEL=nomic-embed-text
# Cloud fallback via any OpenAI-compatible API (OpenRouter, OpenAI, Groq...)
OPENAI_BASE_URL=https://openrouter.ai/api/v1
OPENAI_API_KEY=
JARVIS_FALLBACK_MODEL=qwen/qwen-2.5-72b-instruct

# --- Agent tools & scheduler ---------------------------------------------
# readonly | confirm (default) | auto
JARVIS_TOOL_MODE=confirm
JARVIS_SCHEDULER=true
JARVIS_TZ=
BRAVE_API_KEY=

# --- Voice ---------------------------------------------------------------
# browser | whisper | vosk
STT_ENGINE=browser
WHISPER_MODEL=small.en
VOSK_MODEL_PATH=
# browser | elevenlabs | coqui
TTS_ENGINE=browser
ELEVENLABS_API_KEY=
ELEVENLABS_VOICE_ID=JBFqnCBsd6RMkjVDRZzb
